```java
import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int capacity = sc.nextInt();

        int[] weight = new int[n];
        int[] value = new int[n];

        for (int i = 0; i < n; i++) {
            weight[i] = sc.nextInt();
            value[i] = sc.nextInt();
        }

        int[] dp = new int[capacity + 1];

        for (int i = 0; i < n; i++) {
            for (int w = capacity; w >= weight[i]; w--) {
                dp[w] = Math.max(
                    dp[w],
                    dp[w - weight[i]] + value[i]
                );
            }
        }

        System.out.println("Maximum Value: " + dp[capacity]);

        sc.close();
    }
}
```


Sample Input
4 7
1 1
3 4
4 5
5 7
Sample Output
Maximum Value: 9
